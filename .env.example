# ───── Copy to .env and edit. Never commit .env. ─────
NODE_ENV=production
PORT=3000

# REQUIRED. >= 32 random chars:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Executive Supervisor (Mostafa). Used by `npm run seed` on FIRST run only; the password is stored as an argon2id hash.
# After the first seed you may blank/remove ADMIN_PASSWORD. Blank `KEY=` lines are treated as unset.
ADMIN_EMAIL=mostafa@example.com
ADMIN_DISPLAY_NAME=مصطفى المشرف التنفيذي
ADMIN_PASSWORD=
# Optional 2FA for the admin (base32 secret, add it to any authenticator app). Enforced when set.
ADMIN_TOTP_SECRET=

# Google Sign-In (Web client ID from Google Cloud Console > APIs & Services > Credentials).
# Authorised JavaScript origin must be your site's origin. Leave empty to disable the Google path.
GOOGLE_CLIENT_ID=

COHORT_LABEL=الفرقة الأولى — برنامج علوم البيانات

# Behind nginx/Caddy/Cloudflare tunnel? Set the number of proxy hops (usually 1) so IPs in logs and rate limits are real.
TRUST_PROXY=0
# Defaults to true in production (cookies Secure). Set false ONLY for plain-http testing.
# COOKIE_SECURE=true

STORAGE_DIR=./storage
MAX_UPLOAD_MB=100
LOG_RETENTION_MONTHS=12
RATE_LIMIT_AUTH=30
RATE_LIMIT_ADMIN=8
